# Copy this file to `.env` and adjust values for your local setup.
# cp .env.example .env

# Absolute or relative path to the directory of Markdown notes to scan/index.
KNOWLEDGE_DIR=./notes

# Where LanceDB stores its on-disk vector tables.
LANCEDB_PATH=./.lancedb

# Name of the LanceDB table that holds indexed chunks.
LANCEDB_TABLE=notes

# Sentence-Transformers model used to embed text.
# all-MiniLM-L6-v2 is small (~80MB), fast, and 384-dimensional.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Max tokens per chunk when splitting long documents. Note: all-MiniLM-L6-v2
# truncates inputs at 256 tokens, so 256 is the default. Raise this only if you
# switch EMBEDDING_MODEL to one with a longer context window.
CHUNK_TOKENS=256

# Token overlap between consecutive chunks (preserves context across boundaries).
CHUNK_OVERLAP=50

# Default number of results returned by a search query.
TOP_K=5

# --- Local web server (hybrid "Local Vector Mode" backend) ---
# Host/port the `serve` command binds to. The frontend probes
# http://localhost:8000/status, so keep the port aligned with docs/app.js.
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Directory for the static frontend + generated search_index.json.
# This is also the folder you point GitHub Pages at (main / /docs).
DOCS_DIR=./docs
